# ============================================================
# GridWise environment variables
# Copy to .env and fill in. NEVER commit .env.
# In Databricks, put these in the "gridwise" secret scope instead.
# ============================================================

# ---------- Databricks (REQUIRED) ----------
# Workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# User Settings → Developer → Access tokens
DATABRICKS_TOKEN=
# SQL Warehouses → your warehouse → Connection details → HTTP path (last segment is the ID)
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_HTTP_PATH=
# Unity Catalog catalog name. Use "workspace" if Free Edition won't let you create "grid".
GRIDWISE_CATALOG=grid
# Job ID of the "gridwise-hourly" Databricks Job (set in Phase 4.5)
DATABRICKS_JOB_ID=
# Genie space ID (from the Genie space URL), used if the app embeds Genie Q&A
DATABRICKS_GENIE_SPACE_ID=
# Name of the AI Gateway serving endpoint backed by Gemini (only if Free Edition allows it)
DATABRICKS_GEMINI_ENDPOINT=gemini-advice

# ---------- EIA (REQUIRED for history, FREE) ----------
# Hourly ERCOT demand / wind / solar history (EIA-930). Instant key by email:
# https://www.eia.gov/opendata/register.php   (falls back to the rate-limited DEMO_KEY if empty)
EIA_API_KEY=

# ---------- Gemini (REQUIRED) ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Tiger Data / TimescaleDB (REQUIRED for serving) ----------
# https://console.cloud.timescale.com → service → Connection info
# postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TIGER_DATABASE_URL=

# ---------- ERCOT (OPTIONAL) ----------
# Most gridstatus ERCOT methods need no key. Only needed for gridstatus.ErcotAPI
# (official ERCOT Public API): https://apiexplorer.ercot.com
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_API_SUBSCRIPTION_KEY=

# ---------- Open-Meteo ----------
# No API key needed (free, non-commercial use).
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ---------- Vultr (OPTIONAL, only for CLI / automated deploys) ----------
# https://my.vultr.com/settings/#settingsapi
VULTR_API_KEY=
VULTR_SERVER_IP=

# ---------- GoDaddy (OPTIONAL, only to set DNS via API) ----------
# https://developer.godaddy.com/keys
GODADDY_API_KEY=
GODADDY_API_SECRET=
APP_DOMAIN=gridwise.tech

# ---------- App config ----------
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://gridwise.tech
SPIKE_PRICE_THRESHOLD=100
# Ripple simulator: residential meters assumed in ERCOT (tunable)
RIPPLE_RESIDENTIAL_METERS=9000000

# ---------- Solana (STRETCH) ----------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_PRIVATE_KEY=
